# ── BRUECKENBAUER GMBH — Environment Variables ──────────────────
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set this to infomaniak in the Infomaniak Node.js site environment.
DEPLOY_TARGET=

# ── Analytics (optional) ────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-RKKZZGQ7TT

# ── Contact / RFQ delivery (required in production) ──────────────
# The API returns 503 instead of fake success when these are missing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# ── Bot protection (required in production) ─────────────────────
# Cloudflare Turnstile site key is public; secret key must stay server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Form abuse controls ─────────────────────────────────────────
# Current rate limiting is in-memory and suitable for a single Node.js instance.
# If the hosting setup uses multiple instances, add a shared limiter such as Redis
# or a provider-level WAF/rate-limit rule before launch.
